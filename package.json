    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.5",
    "@types/node": "^26.4.1",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
