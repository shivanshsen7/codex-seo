{
  "name": "codex-seo",
  "version": "0.0.1",
  "private": true,
  "description": "A native Codex plugin for evidence-backed SEO workflows.",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "lint": "biome lint .",
    "format:check": "biome check --linter-enabled=false .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "docs:dev": "blume dev",
    "docs:build": "blume build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.5",
    "@types/node": "^24.13.3",
    "blume": "^1.6.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
